{
  "manifest_version": 2,
  "name": "WA Voice File Sender",
  "version": "1.0.0",
  "description": "Send any audio file to a WhatsApp Web chat as a real voice message (waveform bubble) instead of a document attachment.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "web_accessible_resources": [
    "page-inject.js"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "WA Voice File Sender",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wa-voice-file-sender@local.ext",
      "strict_min_version": "109.0"
    }
  }
}
